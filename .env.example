# ── LLM Provider ─────────────────────────────────────────────────────────
# Set one of these. OpenRouter takes precedence if both are set.
OPENROUTER_API_KEY=sk-or-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── Model ────────────────────────────────────────────────────────────────
# One line sets all 5 agents. Override individuals with GENERATION_MODEL, etc.
DEFAULT_MODEL=deepseek/deepseek-v4-pro
# Other good options (OpenRouter format):
#   anthropic/claude-sonnet-4-6
#   google/gemini-2.0-flash-001
#   openai/gpt-4o-mini

# ── Per-agent overrides (optional — blank = use DEFAULT_MODEL) ────────────
# GENERATION_MODEL=
# REFLECTION_MODEL=
# RANKING_MODEL=
# EVOLUTION_MODEL=
# TRIGGER_MODEL=

# ── Search ───────────────────────────────────────────────────────────────
EXA_API_KEY=...      # Best for recent research papers — recommended
# TAVILY_API_KEY=... # Alternative; falls back to DuckDuckGo if neither set

# ── Persistence (Railway Volume) ─────────────────────────────────────────
# On Railway: create a Volume, set mount path to /data, then set:
# DB_PATH=/data/co_inventor.db
DB_PATH=co_inventor.db

# ── Pipeline tuning (optional) ────────────────────────────────────────────
# ELO_ROUNDS=12
# TOP_K_FOR_EVOLUTION=3
